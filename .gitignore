# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo
.vite/
vite.config.*.timestamp-*

# Cloudflare / Wrangler local state
.wrangler/
.mf/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Environment files (commit only the examples)
.env
.env.*
!.env.example

# Secrets kept locally (Wrangler secrets can't be read back; store values here, mode 600)
.secrets/
*.pem
*.key

# Local D1 dumps taken before migrations: raw production data, never commit
/.backups/
/backups/
/backup-*.sql

# Map data: OSM extracts and tile archives are large and regenerable.
# Host them in R2, not git.
*.osm.pbf
*.osm
*.pmtiles
*.mbtiles
/data/tiles/

# Testing
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Scratch output
tmp/
/outputs/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code local state (shared settings.json and skills stay tracked)
.claude/settings.local.json
.claude/*.lock
.claude/worktrees/

# Standalone local sandbox records
.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
